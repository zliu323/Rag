RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_VECTOR_BACKEND=faiss
RAG_POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag
RAG_HYBRID_ENABLED=true
RAG_OBSERVABILITY_ENABLED=false
RAG_OBSERVABILITY_CAPTURE_CONTENT=false
RAG_LANGFUSE_PUBLIC_KEY=
RAG_LANGFUSE_SECRET_KEY=
RAG_LANGFUSE_BASE_URL=https://cloud.langfuse.com
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_LLM_PROVIDER=extractive
RAG_LLM_MODEL=gpt-4.1-mini
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_DEEPSEEK_MODEL=deepseek-flash
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_API_KEY=
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_RERANK_TOP_N=4
RAG_CONTEXT_MIN_COVERAGE=0.3
RAG_MAX_UPLOAD_MB=20

